{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "kicad",
  "version": "8.99",
  "license": "GPL-2.0+",
  "dependencies": [
    "boost-algorithm",
    "boost-bimap",
    "boost-filesystem",
    "boost-functional",
    "boost-iterator",
    "boost-locale",
    "boost-optional",
    "boost-property-tree",
    "boost-ptr-container",
    "boost-random",
    "boost-range",
    "boost-stacktrace",
    "boost-test",
    "boost-uuid",
    "cairo",
    "curl",
    "expat",
    {
      "name": "gettext",
      "features": [ "tools" ],
      "host": true
    },
    "harfbuzz",
    "glm",
    {
      "name": "opencascade",
      "features": [ "rapidjson" ]
    },
    "opengl",
    "pcre2",
    "python3",
    "openssl",
    {
      "name": "sqlite3",
      "features": [ "fts5", "fts4", "fts3", "rtree", "session" ]
    },
    "icu",
    "ngspice",
    {
      "name": "libgit2",
      "features": [ "ssh", "winhttp" ]
    },
    "nng",
    "protobuf",
    "zlib",
    "zstd"
  ],
  "default-features": [ "wx" ],
  "features": {
    "wx": {
      "description": "The wxWidgets build of KiCad",
      "dependencies": [
        {
          "name": "wxwidgets-33",
          "features": [ "webview" ]
        },
        "wxpython-33"
      ]
    },
    "qt": {
      "description": "The Qt build of KiCad (KICAD_WX_FREE and KICAD_QT_SHELL; VCPKG_MANIFEST_NO_DEFAULT_FEATURES=ON, VCPKG_MANIFEST_FEATURES=qt)",
      "dependencies": [
        "qtbase"
      ]
    }
  },
  "overrides": [
    {
      "name": "glm",
      "version": "0.9.9.8#2",
      "$comment": "Pinned due to bad vcpkg port updating to a non-real version"
    },
    {
      "name": "python3",
      "version": "3.11.5#0"
    },
    {
      "name": "wxwidgets-33",
      "version": "3.3.1#4"
    },
    {
      "name": "wxpython-33",
      "version": "4.2.3#6"
    },
    {
      "name": "ngspice",
      "version": "46#0"
    },
    {
      "name": "protobuf",
      "version": "3.21.12#4",
      "$comment": "Pinned until compat in kicad is improved"
    }
  ]
}
