    (31 "B.Cu" signal)
    (37 "F.SilkS" user "F.Silkscreen")
    (44 "Edge.Cuts" user)
  )

  (setup
    (pad_to_mask_clearance 0)
  )

  (net 0 "")

  (footprint "QA:STEP_MODEL" (layer "F.Cu")
    (uuid "00000000-0000-0000-0000-000000000011")
    (at 110 110)
    (attr smd)
    (fp_text reference "U1" (at 0 -5) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
      (uuid "00000000-0000-0000-0000-000000000012")
    )
    (fp_text value "STEP" (at 0 5) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
      (uuid "00000000-0000-0000-0000-000000000013")
    )
    (model "${KIPRJMOD}/TO-252-2.step"
      (offset (xyz 0 0 0))
      (scale (xyz 1 1 1))
      (rotate (xyz 0 0 0))
    )
  )

  (footprint "QA:VRML_MODEL" (layer "F.Cu")
    (uuid "00000000-0000-0000-0000-000000000021")
    (at 125 110)
    (attr smd)
    (fp_text reference "U2" (at 0 -5) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
      (uuid "00000000-0000-0000-0000-000000000022")
    )
    (fp_text value "VRML" (at 0 5) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
      (uuid "00000000-0000-0000-0000-000000000023")
    )
    (model "${KIPRJMOD}/cube.wrl"
      (offset (xyz 0 0 0))
      (scale (xyz 1 1 1))
      (rotate (xyz 0 0 0))
    )
  )

  (gr_rect (start 100 100) (end 135 120)
    (stroke (width 0.1) (type solid)) (fill none) (layer "Edge.Cuts")
    (uuid "00000000-0000-0000-0000-000000000001")
  )
)
